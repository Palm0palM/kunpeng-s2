#!/bin/bash

usage()
{
    echo "------------------------------------How to use------------------------------------"
    echo "usage     : source setvars.sh"
    echo "------------------------------Parameter Description-------------------------------"
    echo "--kblas   : 'locking', 'nolocking', 'multi'"
    echo "--kspblas : 'single', 'multi'. Default value is 'multi'"
    echo "--kvml    : 'single', 'multi'. Default value is 'single'"
    echo "Examples  : source setvars.sh --kblas=locking "
    echo "----------------------------------------------------------------------------------"
}

implementer=$(cat /proc/cpuinfo | grep "CPU implementer" | awk 'NR==1{printf $4}')
part=$(cat /proc/cpuinfo | grep "CPU part" | awk 'NR==1{printf $4}')
cputype="${implementer}-${part}"

if [ "$0" = "$BASH_SOURCE" ]; then
    echo "Incorrect usage: ${_script_name} must be sourced."
    usage
    exit 0
fi

KMLROOT=$(
  cd $(dirname $BASH_SOURCE)/..
  pwd
)


kml_lib_path_config() (
    kml_lib="$1"
    env_lib="$2"

    if [ "" = "${env_lib}" ]; then
        printf "%s" "${kml_lib}"
    else
        printf "%s" "${kml_lib}:${env_lib}"
    fi
)

setvars_kml_kblas_list=("locking" "nolocking" "multi")
setvars_kml_kspblas_list=("multi" "single")
setvars_kml_kvml_list=("multi" "single")
kblas="multi"
kspblas="multi"
kvml="single"

value_is_valid=""
kml_check_options() {
    local list
    eval list="\${setvars_kml_${1}_list[@]}"
    local value=$2
    value_is_true="true"
    if ! echo "${list[@]}" | grep -w -q "$value"; then
        echo -e "\e[31m'$value' is invalid, 'kml_$1' has been set to the default value.\e[0m"
        value_is_true="false"
    fi
}

kml_parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
        --kblas=*)
            kml_check_options kblas "${1#*=}"
            if [[ $value_is_true == "true" ]] ; then
                kblas="${1#*=}"
            fi
            shift
            ;;
        --kspblas=*)
            kml_check_options kspblas "${1#*=}"
            if [[ $value_is_true == "true" ]] ; then
                kspblas="${1#*=}"
            fi
            shift
            ;;
        --kvml=*)
            kml_check_options kvml "${1#*=}"
            if [[ $value_is_true == "true" ]] ; then
                kvml="${1#*=}"
            fi
            shift
            ;;
        *)
            echo "Unknown option: $1"
            shift
            ;;
        esac
    done
}

kml_parse_args $@

libdir="neon"
kblaslibdir="neon"
get_libpath()
{
    if [ "${cputype}" = "0x48-0xd01" ]; then
        libdir="neon"
        kblaslibdir="neon"
    elif [ "${cputype}" = "0x48-0xd02" ]; then
        libdir="sve"
        kblaslibdir="sve"
    elif [ "${cputype}" = "0x48-0xd03" ]; then
        libdir="sve"
        kblaslibdir="sve"
    elif [ "${cputype}" = "0x48-0xd06" ]; then
        libdir="sve"
        kblaslibdir="sve"
    elif [ "${cputype}" = "0x48-0xd22" ]; then
        libdir="sve512"
        kblaslibdir="sme"
    else
        libdir="neon"
    fi
}

get_libpath

LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib" "${LIBRARY_PATH:-}")
LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$kblaslibdir/kblas/$kblas" "${LIBRARY_PATH:-}")
LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$libdir/kspblas/$kspblas" "${LIBRARY_PATH:-}")
LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/noarch/kvml/$kvml" "${LIBRARY_PATH:-}")
LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/noarch" "${LIBRARY_PATH:-}")
LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$libdir" "${LIBRARY_PATH:-}")

LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib" "${LD_LIBRARY_PATH:-}")
LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$kblaslibdir/kblas/$kblas" "${LD_LIBRARY_PATH:-}")
LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$libdir/kspblas/$kspblas" "${LD_LIBRARY_PATH:-}")
LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/noarch/kvml/$kvml" "${LD_LIBRARY_PATH:-}")
LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/noarch" "${LD_LIBRARY_PATH:-}")
LD_LIBRARY_PATH=$(kml_lib_path_config "${KMLROOT}/lib/$libdir" "${LD_LIBRARY_PATH:-}")

export KMLROOT
export LIBRARY_PATH
export LD_LIBRARY_PATH
export CPATH=${KMLROOT}/include:$CPATH
export INCLUDE=${KMLROOT}/include:$INCLUDE

