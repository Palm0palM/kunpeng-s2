+/* Only call after HWCAP_SVE; vector length belongs to the calling thread. */
+__attribute__((target("arch=armv8-a+sve"), noinline))
+static int trsm_sve_has_eight_doubles(void)
+{
+    return svcntd()==RHS;
+}
+
+/* Eight lanes represent independent RHS columns. Keep each row's k order
+ * and fused multiply-add semantics identical to the original NEON kernel. */
+__attribute__((target("arch=armv8-a+sve"), noinline))
+static void panel_sums_sve(int start,int lda,const double *L,const double *x,double *s)
+{
+    const svbool_t pg=svptrue_b64();
+    svfloat64_t s0=svdup_n_f64(0.0);
+    svfloat64_t s1=svdup_n_f64(0.0);
+    svfloat64_t s2=svdup_n_f64(0.0);
+    svfloat64_t s3=svdup_n_f64(0.0);
+    for(int k=0;k<start;++k) {
+        const svfloat64_t b=svld1_f64(pg,x+(size_t)k*RHS);
+        s0=svmla_n_f64_x(pg,s0,b,L[(size_t)0*lda+k]);
+        s1=svmla_n_f64_x(pg,s1,b,L[(size_t)1*lda+k]);
+        s2=svmla_n_f64_x(pg,s2,b,L[(size_t)2*lda+k]);
+        s3=svmla_n_f64_x(pg,s3,b,L[(size_t)3*lda+k]);
+    }
+    svst1_f64(pg,s+0*RHS,s0);
+    svst1_f64(pg,s+1*RHS,s1);
+    svst1_f64(pg,s+2*RHS,s2);
+    svst1_f64(pg,s+3*RHS,s3);
+}
