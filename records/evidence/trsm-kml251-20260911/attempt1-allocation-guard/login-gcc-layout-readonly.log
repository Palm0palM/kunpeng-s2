KML251_KBLAS_MULTI_MODULE
#%Module1.0#############################################################################
##
##  kblas multi library
##
## Copyright 2024 Huawei Technologies Co. Ltd. All rights reserved.

########################################################################################
# Module description
########################################################################################

proc ModulesHelp { } {
    puts stderr " "
    puts stderr "This module loads the kblas multi library."
}

module-whatis "Huawei Kunpeng Math library"
module-whatis "Description: This module loads the kblas multi library."
########################################################################################
# Main section
########################################################################################
# 获取modulefile路径(含文件名)
set modulefilepathname "${ModulesCurrentModulefile}"
# 获取modulefile绝对路径(含文件名)
set modulefilepathname "[file normalize "$modulefilepathname"]"
# 获取modulefiles绝对路径
set modulefilepath "[file dirname "$modulefilepathname"]"
set modulefilepath "[file dirname "$modulefilepath"]"
# 获取bisheng或gcc版本kml安装路径
set kml_path "[file dirname "$modulefilepath"]"

# 环境变量校验

if { [ is-loaded ./serial-locking ] } {
    puts stderr "ERROR: The environment variable of kblas serial-locking library has added."
    puts stderr "You can module unload kblas serial-locking modulefile, try again."
    exit 1
}

if { [ is-loaded ./serial-nolocking ] } {
    puts stderr "ERROR: The environment variable of kblas serial-nolocking library has added."
    puts stderr "You can module unload kblas serial-nolocking modulefile, try again."
    exit 1
}

set libdir "neon"
set implementer [exec sh -c "cat /proc/cpuinfo | grep 'CPU implementer' | awk 'NR==1{printf \$4}'"]
set part [exec sh -c "cat /proc/cpuinfo | grep 'CPU part' | awk 'NR==1{printf \$4}'"]
set cputype "${implementer}-${part}"

# 根据 CPU 类型设置 libdir
if {[string equal $cputype "0x48-0xd01"]} {
    set libdir "neon"
} elseif {[string equal $cputype "0x48-0xd02"]} {
    set libdir "sve"
} elseif {[string equal $cputype "0x48-0xd03"]} {
    set libdir "sve"
} elseif {[string equal $cputype "0x48-0xd06"]} {
    set libdir "sve"
} elseif {[string equal $cputype "0x48-0xd22"]} {
    set libdir "sme"
} else {
    set libdir "neon"
}

# 设置环境变量
prepend-path    LD_LIBRARY_PATH ${kml_path}/lib/${libdir}/kblas/multi
prepend-path    CPATH ${kml_path}/include
prepend-path    INCLUDE ${kml_path}/include
