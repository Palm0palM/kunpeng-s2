+                    const svfloat32_t ak = svdup_n_f32(ka[column]);
+                    const svfloat32_t bk = svdup_n_f32(kb[column]);
+                    const svfloat32_t ck = svdup_n_f32(kc[column]);
+                    const svfloat32_t dk = svdup_n_f32(kd[column]);
