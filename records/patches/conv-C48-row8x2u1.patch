+        {
+            const float *row = base + (size_t)2 * stride + i;
+            const float *ka = kernel + ((size_t)2) * (size_t)kw;
+            const float *kb = kernel + ((size_t)1) * (size_t)kw;
+            const float *kc = kernel;
