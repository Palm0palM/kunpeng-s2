+/*
+ * 两行共享同一对 kernel 系数，各有独立的 N 个累加器。
+ * 每个输出的乘法、加法仍严格沿 jk/ik 顺序进行；不合并部分和。
+ * base1 = base0 + stride，第二行最后一次读取仅在 j + 1 < oh 时发生。
+ * 默认主块 N=16，总计 32 个累加器，与原 1x32 微块相同。
+ */
+#define DEFINE_CONV_ROWPAIR(NAME, N)                                         \
+CONV_INLINE void NAME(const float *restrict base, size_t stride,              \
+                      const float *restrict kernel, int kh, int kw,          \
+                      float *restrict dst0, float *restrict dst1)            \
+{                                                                            \
+    float acc0[N] = {0.0f};                                                   \
+    float acc1[N] = {0.0f};                                                   \
+    const float *krow = kernel;                                               \
+    for (int jk = 0; jk < kh; ++jk) {                                         \
+        const float *row0 = base + (size_t)jk * stride;                       \
+        const float *row1 = row0 + stride;                                   \
+        int ik = 0;                                                          \
+        if (CONV_KERNEL_UNROLL == 2) {                                        \
+            for (; ik < kw - 1; ik += 2) {                                   \
+                const float k0 = krow[ik];                                   \
+                const float k1 = krow[ik + 1];                               \
+                const float *window0 = row0 + ik;                            \
+                const float *window1 = row1 + ik;                            \
+                _Pragma("omp simd")                                         \
+                for (int b = 0; b < (N); ++b) {                               \
+                    acc0[b] += window0[b] * k0;                              \
+                    acc0[b] += window0[b + 1] * k1;                          \
+                    acc1[b] += window1[b] * k0;                              \
+                    acc1[b] += window1[b + 1] * k1;                          \
+                }                                                            \
+            }                                                                \
+        }                                                                    \
+        for (; ik < kw; ++ik) {                                               \
+            const float k = krow[ik];                                        \
+            const float *window0 = row0 + ik;                                \
+            const float *window1 = row1 + ik;                                \
+            _Pragma("omp simd")                                              \
+            for (int b = 0; b < (N); ++b) {                                   \
+                acc0[b] += window0[b] * k;                                   \
+                acc1[b] += window1[b] * k;                                   \
+            }                                                                \
+        }                                                                    \
+        krow += kw;                                                          \
+    }                                                                        \
+    _Pragma("omp simd")                                                       \
+    for (int b = 0; b < (N); ++b) {                                           \
+        dst0[b] = acc0[b];                                                    \
+        dst1[b] = acc1[b];                                                    \
+    }                                                                        \
+}
+
+DEFINE_CONV_ROWPAIR(conv_rowpair_16, 16)
+DEFINE_CONV_ROWPAIR(conv_rowpair_8, 8)
+DEFINE_CONV_ROWPAIR(conv_rowpair_4, 4)
+DEFINE_CONV_ROWPAIR(conv_rowpair_2, 2)
+DEFINE_CONV_ROWPAIR(conv_rowpair_1, 1)
+#undef DEFINE_CONV_ROWPAIR
 #undef CONV_INLINE
 
